<Window x:Class="Brows.MarkdownSampleWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
        Title="Markdown notebook" Width="1180" Height="800" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F1F0E9"
        FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary Source="Resources/NotebookTheme.xaml" />
  </Window.Resources>
  <DockPanel Margin="24,18,24,24" FocusManager.FocusedElement="{Binding ElementName=Editor}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
      <Border Width="5" Background="{StaticResource Rust}" Margin="0,4,12,3" />
      <TextBlock Text="Markdown notebook" FontFamily="{StaticResource ReadingFace}"
                 FontSize="27" Foreground="{StaticResource Ink}" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="9*" MinWidth="235" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="11*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Border Background="#1F302C" BorderBrush="#162722" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="18,12" BorderThickness="0,0,0,1" BorderBrush="#40544D">
            <Label Target="{Binding ElementName=Editor}" Content="_Markdown source" Padding="0"
                   FontSize="15" FontWeight="SemiBold" Foreground="#D6E7DC" />
          </Border>
          <TextBox x:Name="Editor" AutomationProperties.Name="Markdown source"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="Transparent" Foreground="#F2F4E8" CaretBrush="#FFC88A"
                   SelectionBrush="#518577" BorderThickness="0" Padding="16"
                   FontFamily="{StaticResource WritingFace}" FontSize="14" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="Resize editor and preview" />

      <Border Grid.Column="2" Background="#FFFEF8" BorderBrush="#CBD2C4" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="18,12" BorderThickness="0,0,0,1" BorderBrush="#DADED2">
            <TextBlock Text="Live preview" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Pine}" />
          </Border>
          <brows:MarkdownControl x:Name="Preview" Style="{StaticResource NotebookPreview}"
                                 AutomationProperties.Name="Rendered Markdown"
                                 Markdown="{Binding Text, ElementName=Editor, Mode=OneWay}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
