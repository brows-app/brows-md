<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Brows.Windows.Controls">
  <Style x:Key="MarkdownTableCell" TargetType="{x:Type TableCell}">
    <Setter Property="Padding" Value="4,2" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static TextAlignment.Left}">
        <Setter Property="TextAlignment" Value="Left" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static TextAlignment.Center}">
        <Setter Property="TextAlignment" Value="Center" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static TextAlignment.Right}">
        <Setter Property="TextAlignment" Value="Right" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type controls:MarkdownControl}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MarkdownDocumentStyle">
      <Setter.Value>
        <Style TargetType="{x:Type FlowDocument}">
          <Setter Property="TextAlignment" Value="Left" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading1Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="28" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading2Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="24" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading3Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="20" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading4Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="18" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading5Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="16" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownHeading6Style">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownQuoteStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Section}">
          <Setter Property="BorderThickness" Value="3,0,0,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          <Setter Property="Padding" Value="10,0,0,0" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownCodeBlockStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="FontFamily" Value="Consolas" />
          <Setter Property="Padding" Value="8" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownInlineCodeStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Run}">
          <Setter Property="FontFamily" Value="Consolas" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownThematicBreakStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Paragraph}">
          <Setter Property="BorderThickness" Value="0,1,0,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          <Setter Property="FontSize" Value="1" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownOrderedListStyle">
      <Setter.Value>
        <Style TargetType="{x:Type List}">
          <Setter Property="MarkerStyle" Value="Decimal" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownUnorderedListStyle">
      <Setter.Value>
        <Style TargetType="{x:Type List}">
          <Setter Property="MarkerStyle" Value="Disc" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownStrikethroughStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Span}">
          <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownTableHeaderRowStyle">
      <Setter.Value>
        <Style TargetType="{x:Type TableRow}">
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="MarkdownTableCellStyle" Value="{StaticResource MarkdownTableCell}" />
    <Setter Property="MarkdownTableHeaderCellStyle" Value="{StaticResource MarkdownTableCell}" />
    <Setter Property="MarkdownImageStyle">
      <Setter.Value>
        <Style TargetType="{x:Type Image}">
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="StretchDirection" Value="DownOnly" />
          <Setter Property="MaxWidth" Value="640" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:MarkdownControl}">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <FlowDocumentScrollViewer x:Name="PART_Viewer" IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
