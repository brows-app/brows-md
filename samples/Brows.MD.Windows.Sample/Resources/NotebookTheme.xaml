<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation">
  <SolidColorBrush x:Key="Pine" Color="#214C43" />
  <SolidColorBrush x:Key="Ink" Color="#243830" />
  <SolidColorBrush x:Key="Rust" Color="#944624" />
  <FontFamily x:Key="ReadingFace">Georgia</FontFamily>
  <FontFamily x:Key="WritingFace">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="Page" TargetType="FlowDocument">
    <Setter Property="FontFamily" Value="{StaticResource ReadingFace}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="PagePadding" Value="30,20,30,30" />
    <Setter Property="TextAlignment" Value="Left" />
  </Style>
  <Style x:Key="Title" TargetType="Paragraph">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource Pine}" />
    <Setter Property="Margin" Value="0,0,0,15" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="Paragraph">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pine}" />
    <Setter Property="Margin" Value="0,17,0,9" />
  </Style>
  <Style x:Key="Body" TargetType="Paragraph">
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="FieldQuote" TargetType="Section">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{StaticResource Pine}" />
    <Setter Property="Background" Value="#EAF0E6" />
    <Setter Property="BorderBrush" Value="#75977D" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="14,9,14,6" />
    <Setter Property="Margin" Value="0,12,0,2" />
  </Style>
  <Style x:Key="Observations" TargetType="Table">
    <Setter Property="CellSpacing" Value="0" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="ColumnLabels" TargetType="TableRow">
    <Setter Property="Background" Value="{StaticResource Pine}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Cell" TargetType="TableCell">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="BorderBrush" Value="#CAD6C9" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static TextAlignment.Center}">
        <Setter Property="TextAlignment" Value="Center" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static TextAlignment.Right}">
        <Setter Property="TextAlignment" Value="Right" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Annotation" TargetType="Run">
    <Setter Property="FontFamily" Value="{StaticResource WritingFace}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#F4E7D6" />
    <Setter Property="Foreground" Value="{StaticResource Rust}" />
  </Style>
  <Style x:Key="Checkmark" TargetType="Run">
    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
    <Setter Property="Foreground" Value="{StaticResource Pine}" />
  </Style>
  <Style x:Key="NotebookPreview" TargetType="brows:MarkdownControl">
    <Setter Property="MarkdownDocumentStyle" Value="{StaticResource Page}" />
    <Setter Property="MarkdownHeading1Style" Value="{StaticResource Title}" />
    <Setter Property="MarkdownHeading2Style" Value="{StaticResource SectionTitle}" />
    <Setter Property="MarkdownParagraphStyle" Value="{StaticResource Body}" />
    <Setter Property="MarkdownQuoteStyle" Value="{StaticResource FieldQuote}" />
    <Setter Property="MarkdownTableStyle" Value="{StaticResource Observations}" />
    <Setter Property="MarkdownTableHeaderRowStyle" Value="{StaticResource ColumnLabels}" />
    <Setter Property="MarkdownTableHeaderCellStyle" Value="{StaticResource Cell}" />
    <Setter Property="MarkdownTableCellStyle" Value="{StaticResource Cell}" />
    <Setter Property="MarkdownInlineCodeStyle" Value="{StaticResource Annotation}" />
    <Setter Property="MarkdownTaskMarkerStyle" Value="{StaticResource Checkmark}" />
  </Style>
</ResourceDictionary>
